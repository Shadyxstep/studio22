# Public site URL (used for metadata, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://studio-22.ie

# Google Tag Manager container (owner's Google Ads campaigns).
# GTM renders only when set — leave empty locally; real ID lives in Vercel env.
NEXT_PUBLIC_GTM_ID=

# ---- Dormant payments (SPEC §5, §10). Checkout activates ONLY when
# ---- STUDIO22_PAYMENTS is "true" AND all three Stripe vars are present.
# ---- Every feature works with this file copied to .env as-is (empty keys).
STUDIO22_PAYMENTS=false
STRIPE_SECRET_KEY=                      # HUMAN TODO at activation
STRIPE_WEBHOOK_SECRET=                  # HUMAN TODO at activation
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=     # HUMAN TODO at activation

# ---- v2 owner platform (SPEC §15.1). ALL optional; features degrade gracefully:
# ---- no DATABASE_URL -> content served from content/*.json files
# ---- no ANTHROPIC_API_KEY -> deterministic fake planner/drafter
# ---- no OWNER_PASSWORD_HASH -> dev fallback password "owner" (never in prod)
# ---- no BLOB_READ_WRITE_TOKEN -> uploads unavailable (admin shows notice)
DATABASE_URL=
OWNER_PASSWORD_HASH=                    # generate: pnpm tsx scripts/hash-password.ts <password>
SESSION_SECRET=
ANTHROPIC_API_KEY=
BLOB_READ_WRITE_TOKEN=
